# Copy to .env on the machine that runs BTCTradeBot. .env is git-ignored —
# never commit it, never paste these values anywhere else.

TRADEBOT_MODE=demo

# Which demo account to trade on: okx (default, config.js) or bybit.
EXCHANGE=okx

# --- OKX Demo Trading ---------------------------------------------------
# okx.com -> Trade -> Demo trading, then (still in demo) profile -> Demo
# Trading API -> Create API key. Permissions: Read + Trade only, NO withdraw.
# Bind it to this machine's IP if you can. A demo key only works in demo
# (the bot sends x-simulated-trading: 1 on every request).
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# EEA account (my.okx.com), as used for the demo: set these three.
OKX_API_BASE=https://my.okx.com
OKX_MARGIN_MODE=isolated
# BTC's instrument. The other coins in config.js COINS (ETH, HYPE) pick their own
# USD-settled futures automatically (scripts/lib-coins.sh); override one with
# OKX_INSTRUMENT_ETH=... / OKX_INSTRUMENT_HYPE=... only if OKX renames a contract.
OKX_INSTRUMENT=BTC-USD_UM_XPERP-310328
# Other accounts: leave OKX_API_BASE unset (default https://www.okx.com), OKX_MARGIN_MODE
# defaults to cross, and OKX_INSTRUMENT may be BTC-USDT-SWAP (perpetual) or a spot pair.

# --- Bybit Demo Trading (EXCHANGE=bybit) --------------------------------
# bybit.com -> switch to Demo Trading -> API Management -> Create New Key.
# System-generated, Read-Write, Contract -> Orders + Positions only, NO
# withdrawal/transfer, restricted to this machine's IP.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Set to 1 to stop opening new positions (an open one keeps its exchange stop, which still trails).
TRADEBOT_HALT=0

# Phone alerts via the ntfy app: the topic to publish to (default in config.js).
# NTFY_TOPIC=off turns them off.
# NTFY_TOPIC=
